# Copy to .env.local for local work. On Vercel, set these under Settings → Environment Variables.
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.

# The real public domain, as a bare https origin: no path, no trailing slash.
# Until it is set, the site is noindex and canonical URLs use the Vercel URL
# (or http://localhost:3000 locally). Every production build prints a warning.
NEXT_PUBLIC_SITE_URL=

# Public contact address. Until it is set, the site shows "hello@[domain]" with no mailto link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Set by Vercel automatically, do not add by hand:
# VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV, NEXT_PUBLIC_VERCEL_URL, NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL
